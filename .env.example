# Copia este archivo a .env. Nunca subas tus claves a Git.
PORT=3000
# true fuerza datos ficticios y desactiva la IA incluso si hay claves heredadas.
# Para conectar servicios reales después, cambia a false y configura sus claves.
DEMO_MODE=true
# Sin ODDS_API_KEY, la aplicación usa exclusivamente datos ficticios etiquetados.
ODDS_API_KEY=
ODDS_API_REGIONS=eu
# Opcional: claves de casas del proveedor separadas por coma.
ODDS_API_BOOKMAKERS=
# Sin selección del visitante, consulta como máximo 4 ligas representativas.
# Puedes establecer las claves exactas de tu plan, separadas por coma.
ODDS_API_SPORT_KEYS=
ODDS_MAX_AGE_MINUTES=15
ODDS_MAX_REQUESTS_PER_HOUR=100
# OpenAI, solo desde el servidor. No uses VITE_ para credenciales.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MAX_REQUESTS_PER_HOUR=100
# Detrás de un único proxy de confianza en el hosting, fija TRUST_PROXY=1.
# Déjalo desactivado cuando sirvas directamente desde Node.
TRUST_PROXY=0
